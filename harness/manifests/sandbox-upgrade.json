{
  "schemaVersion": "1.0",
  "featureId": "sandbox-upgrade",
  "title": "Sandbox upgrade and retention verification",
  "sources": {
    "designDocs": [
      "docs/design/1.0.4/sandbox-upgrade-auto-patch.md",
      "docs/design/1.0.2/Sandbox 备份与升级 — 设计.md"
    ],
    "uiArtifacts": [
      "agent-manager/tests/ui"
    ]
  },
  "platformInputs": {
    "required": [
      "workItemId",
      "milestoneId",
      "ownerTokenRef",
      "agentId",
      "acceptanceCommand"
    ],
    "optional": [
      "targetClusterId",
      "targetNamespace",
      "kubeconfigSecretRef",
      "evidenceUploadTarget"
    ]
  },
  "stages": [
    "clarify",
    "dev_orchestration",
    "env_prepare",
    "develop",
    "test_unit",
    "deploy_ephemeral",
    "test_api",
    "test_e2e",
    "integration_live",
    "code_review",
    "deploy"
  ],
  "tasks": [
    {
      "id": "clarify-sandbox-upgrade-inputs",
      "stage": "clarify",
      "dependsOn": [],
      "resources": [],
      "writeScope": [],
      "description": "Verify design doc, UI input policy, real sandbox-upgrade scope, environment inputs, and success criteria."
    },
    {
      "id": "orchestrate-sandbox-upgrade-delivery",
      "stage": "dev_orchestration",
      "dependsOn": [
        "clarify-sandbox-upgrade-inputs"
      ],
      "resources": [],
      "writeScope": [],
      "description": "Publish allowlist, resource locks, isolated environment, API/browser tests, and evidence plan."
    },
    {
      "id": "prepare-sandbox-upgrade-environment",
      "stage": "env_prepare",
      "dependsOn": [
        "orchestrate-sandbox-upgrade-delivery"
      ],
      "resources": [
        "k8s:ephemeral-namespace",
        "k8s:ephemeral-service",
        "image:agent-manager",
        "supabase:test",
        "e2b:quota"
      ],
      "writeScope": [],
      "description": "Create or bind the dedicated namespace/service/baseUrl, image tag, database isolation, E2B input, and secret refs."
    },
    {
      "id": "sandbox-upgrade-api",
      "stage": "develop",
      "dependsOn": [
        "prepare-sandbox-upgrade-environment"
      ],
      "resources": [
        "file:backend",
        "k8s:target-namespace"
      ],
      "writeScope": [
        "agent-manager/server/**/*upgrade*",
        "agent-manager/server/services/kubernetes-api.js",
        "agent-manager/tests/integration/suites/sandbox-upgrade/**"
      ],
      "description": "Implement or review SandboxUpdateOps API and Kubernetes patch generation.",
      "agentPacket": true
    },
    {
      "id": "deploy-sandbox-upgrade-ephemeral",
      "stage": "deploy_ephemeral",
      "dependsOn": [
        "sandbox-upgrade-api"
      ],
      "resources": [
        "k8s:ephemeral-namespace",
        "k8s:ephemeral-service",
        "image:agent-manager"
      ],
      "writeScope": [],
      "description": "Deploy the current sandbox-upgrade build into the dedicated namespace/service and read back health."
    },
    {
      "id": "api-sandbox-upgrade-readback",
      "stage": "test_api",
      "dependsOn": [
        "deploy-sandbox-upgrade-ephemeral"
      ],
      "resources": [
        "k8s:ephemeral-service",
        "supabase:test",
        "e2b:quota"
      ],
      "writeScope": [],
      "description": "Run sandbox-upgrade API checks against the isolated environment baseUrl."
    }
  ],
  "testMatrix": [
    {
      "id": "sandbox-upgrade-unit",
      "stage": "test_unit",
      "command": "cd agent-manager && npx vitest run tests/unit/sandbox-upgrades.test.js",
      "resources": [
        "file:tests"
      ],
      "evidence": [
        "exitCode",
        "testsPassed",
        "totalTests"
      ]
    },
    {
      "id": "sandbox-upgrade-deploy-ephemeral",
      "stage": "deploy_ephemeral",
      "command": "kubectl -n <namespace> rollout status deployment/<serviceName> && curl -fsS <baseUrl>/api/health",
      "resources": [
        "k8s:ephemeral-namespace",
        "k8s:ephemeral-service",
        "image:agent-manager"
      ],
      "evidence": [
        "namespace/service",
        "imageTag",
        "rollout status",
        "/api/health"
      ],
      "requiresHumanInput": true
    },
    {
      "id": "sandbox-upgrade-api",
      "stage": "test_api",
      "command": "cd agent-manager && TEST_BASE_URL=<baseUrl> npm run test:integration:sandbox-upgrade",
      "resources": [
        "k8s:ephemeral-service",
        "supabase:test",
        "e2b:quota"
      ],
      "evidence": [
        "baseUrl",
        "API response",
        "testsPassed",
        "totalTests",
        "stdout"
      ],
      "requiresHumanInput": true
    },
    {
      "id": "sandbox-upgrade-browser",
      "stage": "test_e2e",
      "command": "cd agent-manager && TEST_BASE_URL=<baseUrl> npx playwright test tests/ui/sandbox-upgrade.spec.ts --config playwright.config.ts",
      "resources": [
        "k8s:ephemeral-service",
        "file:frontend"
      ],
      "evidence": [
        "feature screenshots",
        "trace or video on failure",
        "console/network summary"
      ],
      "requiresHumanInput": true
    },
    {
      "id": "sandbox-upgrade-integration",
      "stage": "integration_live",
      "command": "cd agent-manager && npm run test:integration:sandbox-upgrade",
      "resources": [
        "supabase:test",
        "e2b:quota",
        "k8s:target-namespace"
      ],
      "evidence": [
        "API response",
        "SandboxUpdateOps resource",
        "retention evidence",
        "integration.xml or stdout"
      ],
      "requiresHumanInput": true
    }
  ],
  "evidence": [
    "SandboxUpdateOps resource",
    "Pod or sandbox status",
    "retention files or user-state evidence",
    "integration test output"
  ],
  "humanGates": [
    {
      "stage": "integration_live",
      "type": "clarification",
      "reason": "Live upgrade verification needs isolated namespace or explicit approval to use shared pre-release resources."
    },
    {
      "stage": "deploy",
      "type": "approval",
      "reason": "Deployment must wait for Harness milestone acknowledgement."
    }
  ]
}
