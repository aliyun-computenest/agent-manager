# Agent Manager - 集成测试环境变量示例
# 复制为 agent-manager/.env.test 后按需填写；真实 .env.test 已在 .gitignore 中，请勿提交。

# ---- 被测后端入口（指向已部署的 ACS 环境） ----
TEST_BASE_URL=https://your-acs-ingress-host

# ---- 测试用独立 Supabase 项目 ----
TEST_VITE_SUPABASE_URL=https://<test-proj>.supabase.co
TEST_VITE_SUPABASE_ANON_KEY=
TEST_SERVICE_ROLE_KEY=

# ---- 测试管理员账号（global-setup 会自动创建/修复 role=admin） ----
TEST_ADMIN_EMAIL=it-admin@test.local
TEST_ADMIN_PASSWORD=ChangeMe-Str0ng!

# ---- 运行控制 ----
# TEST_RUN_ID 默认取 Date.now().toString(36)，作为所有测试实体命名前缀：it-<runId>-xxx
TEST_RUN_ID=
# 失败后是否仍执行 afterAll 清理（默认 true）
TEST_CLEAN_ON_FAILURE=true
# 单个 HTTP 请求超时（毫秒）
TEST_REQUEST_TIMEOUT_MS=30000
# 实例 provision 等待 ready 超时（毫秒）
TEST_INSTANCE_READY_TIMEOUT_MS=180000
# Checkpoint 恢复会经历 Pod 重建和镜像拉取，单独给予 360 秒就绪时间
TEST_CHECKPOINT_RESTORE_READY_TIMEOUT_MS=360000
# 可选：POST /api/instances、PUT /api/instances/:id 这类"写"请求的单独超时（毫秒）
#   默认取 max(TEST_INSTANCE_READY_TIMEOUT_MS, 120000)，覆盖 APIG consumer + E2B create 同步阶段
# TEST_INSTANCE_WRITE_TIMEOUT_MS=180000

# ---- 按环境能力跳过某些用例 ----
# 未配置 E2B 时建议置 true，跳过真实 provision 相关用例
TEST_SKIP_E2B=false
# 实例主链路里仅跳过「修改模型 / 修改渠道」两步（仍执行创建/暂停/唤醒/删除）
TEST_SKIP_INSTANCE_MODIFY=false

# Sandbox 升级 FVT：默认会自动寻找已配置 hooks 的 Agent Type 跑只读列表和 no-match 负向校验。
# 配置 TEST_SANDBOX_UPGRADE_AGENT_TYPE_ID 后，会固定使用该 Agent Type。
TEST_SKIP_SANDBOX_UPGRADE=false
# 全量 CI 默认开启真实升级保留性 FVT；本地无 kubeconfig 时可置 false。
TEST_SANDBOX_UPGRADE_RETENTION=true
# 可选；本地不填时使用 ~/.kube/config，CI 会从仓库 secret HZ_KUBECONFIG_B64 生成。
# TEST_KUBECONFIG=
# TEST_SANDBOX_UPGRADE_AGENT_TYPE_ID=

# ---- Hermes 升级 FVT ----
# 跳过 Hermes 升级测试（默认 false）
TEST_SKIP_HERMES_UPGRADE=false
# 全量 CI 默认开启 Hermes 真实升级保留性 FVT
TEST_HERMES_UPGRADE_RETENTION=true
# 可选：指定 Hermes Agent Type ID（不填则自动查找 code=hermes 的 Agent Type）
# TEST_HERMES_UPGRADE_AGENT_TYPE_ID=

# ---- QwenPaw 升级 FVT ----
# 跳过 QwenPaw 升级测试（默认 false）
TEST_SKIP_QWENPAW_UPGRADE=false
# 全量 CI 默认开启 QwenPaw 真实升级保留性 FVT；本地无 kubeconfig 时可置 false。
TEST_QWENPAW_UPGRADE_RETENTION=true
# 可选：指定 QwenPaw Agent Type ID（不填则自动查找 code=qwenpaw 的 Agent Type）
