# Supabase 配置模板
# 复制此文件为 .env 并填入真实的密钥值

# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project.supabase.opentrust.net

# Supabase Anon Key (公开密钥,用于前端)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (超级敏感,仅用于后端服务器)
SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL 数据库连接 (用于迁移和服务端)
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.opentrust.net:5432/postgres

# ========================================
# Backend Server Configuration
# ========================================
SERVER_PORT=3001
VITE_API_URL=http://localhost:3001
VITE_APP_ID=public

# ========================================
# E2B Sandbox Configuration
# ========================================
E2B_API_KEY=your-e2b-api-key
E2B_DOMAIN=your-e2b-domain.com
NATIVE_AGENT_UI_ENABLED=false
# Existing public Manager URL. The native UI preview reuses its exact origin.
PLATFORM_PUBLIC_URL=https://agent-manager.example.com
E2B_IP=xx.xx.xx.xx
SSL_CERT_FILE=./data/ca-fullchain.pem

# Skill CSI 卷挂载使用的 PV 名称（前后端共用，后端用于沙箱创建时的兜底注入，前端由 Vite 注入作为表单默认值）
VITE_OSS_PV_NAME=your-pv-name

# ========================================
# Deployment Environment Configuration
# ========================================
# DEPLOY_ENVIRONMENT: Controls hosts auto-add behavior
# - local-dev: Auto-add hosts to /etc/hosts (for local development)
# - cloud-dev: Only print hosts, no auto-add (for cloud development)
# - production: Only print hosts, no auto-add (for production)
DEPLOY_ENVIRONMENT=local-dev

# Agent 模板配置路径
OPENCLAW_TEMPLATE_PATH=./data/openclaw-template.json

# API 加密密钥 (用于加密存储敏感配置，如 API Key 等)
# 重要：请使用足够长的随机字符串，建议 32 位以上
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ENCRYPTION_KEY=your-encryption-key-here

# ========================================
# AI Gateway Configuration (阿里云 APIG)
# ========================================
# 设置为 'true' 启用阿里云 AI 网关
ENABLE_AI_GATEWAY=false
APIG_GATEWAY_ID=your-gateway-id
APIG_HTTP_API_ID=your-http-api-id
APIG_ENVIRONMENT_ID=your-environment-id
APIG_REGION_ID=cn-shanghai
AI_GATEWAY_DOMAIN=your-environment-id-cn-shanghai.alicloudapi.com
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# ========================================
# SkillHub 在线安装
# ========================================
# 通用下载角色；平台 AK 只需要拥有对该角色的 sts:AssumeRole 权限
SKILLHUB_ASSUME_ROLE_ARN=acs:ram::1234567890123456:role/ComputeNestSkillHubAccessRole
# SkillHub 控制面地域；国内站使用 cn-hangzhou，国际站使用 ap-southeast-1
# Optional override for tests/diagnostics. Leave blank to auto-detect the
# domestic or international SkillHub endpoint from the STS AccountId.
SKILLHUB_REGION_ID=
SKILL_INSTALL_TIMEOUT_SECONDS=600
SKILLHUB_STS_DURATION_SECONDS=900

# ========================================
# Model Keys (模型 API 密钥)
# ========================================
DASHSCOPE_API_KEY=your-dashscope-api-key

# ========================================
# Kubernetes / 集群配置
# ========================================
# 阿里云 ACK 集群 ID (前端展示用)
VITE_ACS_CLUSTER_ID=your-cluster-id

# OOS Checkpoint 备份公共模板
CHECKPOINT_BACKUP_OOS_TEMPLATE_NAME=ACS-CS-CreateAgentManagercheckpointBackup
# Optional: pin a public OOS template version. Omit to use the latest version.
# CHECKPOINT_BACKUP_OOS_TEMPLATE_VERSION=v3
CHECKPOINT_BACKUP_OOS_ASSUME_ROLE=AgentManagerOOSServiceRole
# When set, Agent Manager assumes this role before calling OOS.
# CHECKPOINT_BACKUP_OOS_ASSUME_ROLE_ARN=acs:ram::1234567890123456:role/agentmanageroosservicerole-example

# ========================================
# Admin Bootstrap (初始管理员账户)
# ========================================
# 初始化时创建的管理员账户 (仅首次部署时使用)
ADMIN_EMAIL=admin@openclaw.local
ADMIN_PASSWORD=admin123456

# ========================================
# OSS Configuration (对象存储)
# ========================================
# OSS 管理控制台地址 (前端"前往 OSS 导入技能"按钮跳转地址)
VITE_OSS_URL=https://your-oss-console-url
