{
  "name": "agent-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:ui:batch-import": "node scripts/browser-batch-import-check.mjs",
    "test:ui:batch-import:headed": "node scripts/browser-batch-import-check.mjs --headed",
    "prepare": "cd .. && husky agent-manager/.husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:migration-baseline": "vitest run tests/unit/migration-baseline.test.js",
    "test:integration": "vitest run --config tests/integration/vitest.config.js",
    "test:integration:watch": "vitest --config tests/integration/vitest.config.js",
    "test:integration:smoke": "vitest run --config tests/integration/vitest.config.js suites/smoke",
    "test:integration:sandbox-upgrade": "vitest run --config tests/integration/vitest.config.js suites/sandbox-upgrade"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@alicloud/sts20150401": "^1.2.0",
    "@kubernetes/client-node": "^1.4.0",
    "@scalar/api-reference": "^1.57.5",
    "@scalar/express-api-reference": "^0.9.19",
    "@supabase/supabase-js": "^2.100.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "date-fns": "^2.30.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.6",
    "pg": "^8.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.4",
    "react-infinite-scroll-component": "^7.2.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.59.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.22",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.54.2",
    "tailwindcss": "^3.3.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.1",
    "vitest": "^3.0.0"
  }
}
