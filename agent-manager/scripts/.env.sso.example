# SSO 脚本环境变量配置
# 使用前请设置以下环境变量

# Supabase 项目引用 ID
export SUPABASE_PROJECT_REF="your-project-ref"

# Supabase Personal Access Token
export SUPABASE_ACCESS_TOKEN="your-access-token"

# 阿里云 IDaaS SAML Metadata URL
export IDAAS_METADATA_URL="https://your-idaas-instance.aliyunidaas.com/api/v2/app-xxx/saml2/meta"

# SSO 域名（多个用逗号分隔）
export SSO_DOMAINS="openclaw.local,your-company.com"
